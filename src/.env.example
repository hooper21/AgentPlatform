# Скопируйте в .env (файл .env в git не попадает) и задайте свои значения.
# Секреты и строки подключения хранятся только в переменных окружения.

POSTGRES_DB=agentplatform
POSTGRES_USER=agentplatform
POSTGRES_PASSWORD=change-me-postgres-password

# Обязательно: пароль admin-пользователя для проверочного seed.
AGENTPLATFORM_SEED_ADMIN_PASSWORD=change-me-admin-password
AGENTPLATFORM_SEED_ADMIN_EMAIL=admin@demo.local
AGENTPLATFORM_SEED_TENANT_NAME=Demo Tenant
# true — дополнительно создать operator@demo.local и viewer@demo.local (пароль админа).
AGENTPLATFORM_SEED_ROLE_USERS=true

# AES-256 мастер-ключ Secret Service (base64, 32 байта). KMS-заглушка, см. TODO(kms).
# Сгенерируйте свой: openssl rand -base64 32
AGENTPLATFORM_SECRETS_MASTER_KEY=YWdlbnRwbGF0Zm9ybS1kZXYtbWFzdGVyLWtleS0zMmI=

# Development | Production
ASPNETCORE_ENVIRONMENT=Development

# Тег локально собираемых образов
AGENTPLATFORM_IMAGE_TAG=dev
