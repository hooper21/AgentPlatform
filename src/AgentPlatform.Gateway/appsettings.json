{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "RateLimit": {
      "Storage": "redis",
      "Capacity": 30,
      "TokensPerSecond": 2,
      "Cost": 1,
      "KeyTtl": "00:05:00",
      "KeyPrefix": "agentplatform:rate-limit:tenant:"
    },
    "Llm": {
      "Retries": 2,
      "RetryDelay": "00:00:00.200"
    }
  },
  "AllowedHosts": "*"
}

