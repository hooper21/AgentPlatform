{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Knowledge": {
    "EmbeddingModel": "nomic-embed-text",
    "EmbeddingDimensions": 768,
    "ChunkSizeTokens": 500,
    "ChunkOverlapTokens": 50,
    "DefaultTopK": 5,
    "DefaultThreshold": 0.77,
    "SiteMaxPages": 20,
    "SiteRequestTimeout": "00:00:05",
    "SiteUserAgent": "AgentPlatformKnowledge/1.0",
    "UseInMemoryVectorStore": false,
    "EnableScheduledReindex": true,
    "ReindexPollInterval": "00:01:00"
  },
  "AllowedHosts": "*"
}

