{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Knowledge": {
    "EmbeddingModel": "nomic-embed-text",
    "EmbeddingDimensions": 768,
    "ChunkSizeTokens": 500,
    "ChunkOverlapTokens": 50,
    "DefaultTopK": 5,
    "DefaultThreshold": 0.77,
    "SiteMaxPages": 20,
    "SiteRequestTimeout": "00:00:05",
    "SiteUserAgent": "AgentPlatformKnowledge/1.0",
    "UseInMemoryVectorStore": false,
    "EnableScheduledReindex": true,
    "ReindexPollInterval": "00:01:00",
    "Confluence": {
      "PageSize": 100,
      "MaxPagesPerSpace": 10000,
      "MaxSpaces": 1000,
      "RequestTimeout": "00:00:30",
      "MaxRetries": 4,
      "RetryBaseDelay": "00:00:01",
      "RetryMaxDelay": "00:00:30",
      "RetryJitterFactor": 0.2,
      "ModifiedOverlap": "00:02:00",
      "UserAgent": "AgentPlatformKnowledge/1.0",
      "CloudApiRoot": "https://api.atlassian.com"
    }
  },
  "AllowedHosts": "*"
}

